{
  "name": "koindx-v3-periphery",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0",
  "description": "KoinDX v3 periphery contracts (position manager NFT, swap router and quoter) for the KoinDX v3 core on Koinos",
  "dependencies": {
    "dotenv": "^16.0.3",
    "koilib": "^5.5.6"
  },
  "devDependencies": {
    "@assemblyscript/loader": "0.19.23",
    "@ethereumjs/evm": "2.2.1",
    "@ethereumjs/util": "^9.0.3",
    "@ethersproject/abi": "^5.7.0",
    "@ethersproject/keccak256": "^5.7.0",
    "@koinos/abi-proto-gen": "1.0.0",
    "@koinos/as-gen": "1.0.0",
    "@koinos/as-proto-gen": "1.0.3",
    "@koinos/proto-js": "1.0.0",
    "@koinos/sdk-as": "1.0.2",
    "@roaminroe/protoc": "^2.4.0",
    "@typescript-eslint/eslint-plugin": "^5.10.0",
    "@typescript-eslint/parser": "^5.10.0",
    "@uniswap/sdk-core": "^4.0.7",
    "@uniswap/v3-sdk": "^3.10.0",
    "assemblyscript": "0.19.23",
    "eslint": "^8.7.0",
    "jest": "^29.5.0",
    "jsbi": "^3.2.5",
    "protobufjs": "^6.11.2",
    "solc": "0.7.6",
    "typescript": "^4.5.5"
  },
  "scripts": {
    "lint": "eslint --max-warnings 0 --ext ts \"./contracts/**/*.ts\" \"./libraries/**/*.ts\" \"./utils/**/*.ts\" \"./base/**/*.ts\" \"./interfaces/**/*.ts\" \"./tests/harness/**/*.ts\"",
    "build:debug": "node scripts/build.js debug",
    "build:release": "node scripts/build.js release",
    "build:debug:manager": "node scripts/build.js debug manager",
    "build:release:manager": "node scripts/build.js release manager",
    "build:debug:router": "node scripts/build.js debug router",
    "build:release:router": "node scripts/build.js release router",
    "build:debug:quoter": "node scripts/build.js debug quoter",
    "build:release:quoter": "node scripts/build.js release quoter",
    "build:test-harness": "node scripts/build-harness.js",
    "test": "node scripts/build.js release --network local && yarn build:test-harness && jest --rootDir tests",
    "deploy": "node scripts/deploy.js",
    "sync-core": "node scripts/sync-core.js",
    "check-shared": "node scripts/check-shared.js"
  }
}
