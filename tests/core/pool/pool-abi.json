      "return": "pool.observations_result",
      "entry_point": 3217401524,
      "read_only": true
    },
    "observe": {
      "description": "Get the cumulative tick and liquidity as of each timestamp `seconds_agos` from the current block timestamp",
      "argument": "pool.observe_arguments",
      "return": "pool.observe_result",
      "entry_point": 1961398985,
      "read_only": true
    },
    "snapshot_cumulatives_inside": {
      "description": "Get a snapshot of the tick cumulative, seconds per liquidity and seconds inside a tick range",
      "argument": "pool.snapshot_cumulatives_inside_arguments",
      "return": "pool.snapshot_cumulatives_inside_result",
      "entry_point": 3385500498,
      "read_only": true
    },
    "get_populated_ticks": {
      "description": "Get a page of initialized ticks (like Uniswap TickLens), ordered by tick",
      "argument": "pool.get_populated_ticks_arguments",
      "return": "pool.get_populated_ticks_result",
      "entry_point": 1430213741,
      "read_only": true
    },
    "quote_swap": {
      "description": "Simulate a swap without modifying the state (used by the quoter)",
      "argument": "pool.quote_swap_arguments",
      "return": "pool.quote_swap_result",
      "entry_point": 1846861930,
      "read_only": true
    },
    "configure": {
      "description": "Set the immutable parameters of the pool, called once by the factory when the pool is created",
      "argument": "pool.configure_arguments",
      "return": "pool.empty_object",
      "entry_point": 2429587032,
      "read_only": false
    },
    "initialize": {
      "description": "Set the initial price for the pool",
      "argument": "pool.initialize_arguments",
      "return": "pool.empty_object",
      "entry_point": 1192148610,
      "read_only": false
    },
    "mint": {
      "description": "Add liquidity for the given recipient/tick_lower/tick_upper position. The caller receives a koindx_v3_mint_callback",
      "argument": "pool.mint_arguments",
      "return": "pool.mint_result",
      "entry_point": 3698268091,
      "read_only": false
    },
    "collect": {
      "description": "Collect tokens owed to a position. The position owner is the calling contract, or `owner` (who must authorize the operation) when called directly",
      "argument": "pool.collect_arguments",
      "return": "pool.collect_result",
      "entry_point": 2172800144,
      "read_only": false
    },
    "burn": {
      "description": "Burn liquidity from the sender and account tokens owed for the liquidity to the position. The position owner is the calling contract, or `owner` (who must authorize the operation) when called directly",
      "argument": "pool.burn_arguments",
      "return": "pool.burn_result",
      "entry_point": 2241834181,
      "read_only": false
    },
    "swap": {
      "description": "Swap token0 for token1 (zero_for_one), or token1 for token0. Exact input: `amount_specified` of the input token is paid, exact output: `amount_specified` of the output token is received. The caller receives a koindx_v3_swap_callback",
      "argument": "pool.swap_arguments",
      "return": "pool.swap_result",
      "entry_point": 3662136052,
      "read_only": false
    },
    "flash": {
      "description": "Receive token0 and/or token1 and pay it back, plus a fee, in the koindx_v3_flash_callback",
      "argument": "pool.flash_arguments",
      "return": "pool.empty_object",
      "entry_point": 2233353149,
      "read_only": false
    },
    "increase_observation_cardinality_next": {
      "description": "Increase the maximum number of price and liquidity observations that this pool will store",
      "argument": "pool.increase_observation_cardinality_next_arguments",
      "return": "pool.empty_object",
      "entry_point": 1228394800,
      "read_only": false
    },
    "set_fee_protocol": {
      "description": "Set the denominator of the protocol's % share of the fees (only factory owner)",
      "argument": "pool.set_fee_protocol_arguments",
      "return": "pool.empty_object",
      "entry_point": 1125609654,
      "read_only": false
    },
    "collect_protocol": {
      "description": "Collect the protocol fee accrued to the pool (only factory owner)",
      "argument": "pool.collect_protocol_arguments",
      "return": "pool.collect_protocol_result",
      "entry_point": 2993728766,
      "read_only": false
    }
  },
