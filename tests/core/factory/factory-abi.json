{
  "methods": {
    "owner": {
      "description": "Get the current owner of the factory",
      "argument": "factory.owner_arguments",
      "return": "factory.address",
      "entry_point": 1276127593,
      "read_only": true
    },
    "authorize": {
      "description": "Check if authorized",
      "read-only": false,
      "argument": "koinos.chain.authorize_arguments",
      "return": "koinos.chain.authorize_result",
      "entry_point": 1244511632
    },
    "pending_owner": {
      "description": "Get the owner proposed by set_owner, empty if none (it becomes the owner when it calls accept_owner)",
      "argument": "factory.pending_owner_arguments",
      "return": "factory.address",
      "entry_point": 3446731111,
      "read_only": true
    },
    "fee_amount_tick_spacing": {
      "description": "Get the tick spacing for a given fee amount, if enabled, or 0 if not enabled",
      "argument": "factory.fee_amount_tick_spacing_arguments",
      "return": "factory.int32_value",
      "entry_point": 480751019,
      "read_only": true
    },
    "get_pool": {
      "description": "Get the pool address for a given pair of tokens and a fee, or an empty address if it does not exist",
      "argument": "factory.get_pool_arguments",
      "return": "factory.address",
      "entry_point": 1544779537,
      "read_only": true
    },
    "allowances_exempt": {
      "description": "Whether create_pool skips the allowance check of a token (see set_allowances_exempt)",
      "argument": "factory.allowances_exempt_arguments",
      "return": "factory.bool_value",
      "entry_point": 2026655892,
      "read_only": true
    },
    "get_pools": {
      "description": "Get a page of the pools created by the factory, starting at index `start`",
      "argument": "factory.get_pools_arguments",
      "return": "factory.get_pools_result",
      "entry_point": 972238462,
      "read_only": true
    },
    "create_pool": {
      "description": "Create a pool for the given two tokens and fee. Must be an operation of the transaction (not a call from a contract) that uploads the pool bytecode in an earlier operation; the pool address must have no allowances on the two tokens",
      "argument": "factory.create_pool_arguments",
      "return": "factory.address",
      "entry_point": 3555924671,
      "read_only": false
    },
    "set_owner": {
      "description": "Propose a new owner of the factory (only owner): it becomes the owner when it calls accept_owner",
      "argument": "factory.set_owner_arguments",
      "return": "factory.empty_object",
      "entry_point": 238845787,
      "read_only": false
    },
    "accept_owner": {
      "description": "Accept the ownership of the factory (only the owner proposed by set_owner)",
      "argument": "factory.accept_owner_arguments",
      "return": "factory.empty_object",
      "entry_point": 3668871220,
      "read_only": false
    },
    "enable_fee_amount": {
      "description": "Enable a fee amount with the given tick spacing (only owner)",
      "argument": "factory.enable_fee_amount_arguments",
      "return": "factory.empty_object",
      "entry_point": 12902682,
      "read_only": false
    },
    "set_allowances_exempt": {
      "description": "Exempt a token from the allowance check of create_pool, or remove the exemption (only owner). Only for tokens that have no allowances (no approve, e.g. KCS-1 tokens) and so can't answer get_allowances",
      "argument": "factory.set_allowances_exempt_arguments",
      "return": "factory.empty_object",
      "entry_point": 2686116206,
      "read_only": false
    }
  },
